[Unit]
Description=Mark-LV Desktop Assistant (JARVIS)
Documentation=https://github.com/muzzu/Mark-LV
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/Mark-LV
ExecStart=%h/Projects/Mark-LV/.venv/bin/python3 main.py
Restart=on-failure
RestartSec=3

# Wayland / Audio Environment
Environment="PYTHONUNBUFFERED=1"
Environment="DISPLAY=:0"
PassEnvironment=WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS

# Sandbox & Resource limits
LimitNOFILE=65536
Nice=-5

[Install]
WantedBy=graphical-session.target
