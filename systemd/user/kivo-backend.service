[Unit]
Description=KIVO Backend
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/KIVO_V1
ExecStart=%h/Projects/KIVO_V1/.venv/bin/python -m kivo
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
